# Mausam Mitra API — copy to .env and adjust locally. Do not commit .env.
APP_NAME=mausam-mitra-api
APP_ENV=development
APP_DEBUG=false

# Async SQLAlchemy + psycopg3
DATABASE_URL=postgresql+psycopg://mausam:mausam_dev_password@localhost:5433/mausam_mitra

# Comma-separated browser origins allowed to call the API
# Include both localhost and 127.0.0.1 (browsers treat them as different origins).
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Docker Compose postgres defaults (used by docker-compose.yml)
POSTGRES_DB=mausam_mitra
POSTGRES_USER=mausam
POSTGRES_PASSWORD=mausam_dev_password
POSTGRES_PORT=5433

# Phase 8: Weather Ingestion
WEATHER_PROVIDER=OpenWeatherMap
WEATHER_API_KEY=YOUR_OPENWEATHER_API_KEY_HERE
WEATHER_BASE_URL=https://api.openweathermap.org/data/2.5
WEATHER_EVIDENCE_RADIUS_KM=10.0
WEATHER_EVIDENCE_TIME_WINDOW_MINUTES=90

JWT_SECRET_KEY=YOUR_SUPER_SECRET_KEY_HERE
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
